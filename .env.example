# Copy this file to .env.local and fill in values. Never commit .env.local.
# The app checks these on startup (see src/lib/env.ts).

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (login). Get both keys from the Clerk dashboard: API keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Database (Neon). In the Neon dashboard click "Connect" and copy BOTH links:
# the pooled one (host contains "-pooler") and the direct one (untick "Connection pooling").
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Clerk webhook secret. Leave empty for now; needed only when deploying (Milestone 15).
CLERK_WEBHOOK_SIGNING_SECRET=

# File uploads (UploadThing). Create a free app at https://uploadthing.com, open your app,
# then API Keys, and copy the value called UPLOADTHING_TOKEN (a long encoded string).
UPLOADTHING_TOKEN=

# Background jobs (Trigger.dev). Create a free account/project at https://trigger.dev, then
# Project settings > API keys > copy the dev secret key (starts with tr_dev_).
# Also paste your project ref (starts with proj_) into trigger.config.ts — it is not a secret.
TRIGGER_SECRET_KEY=tr_dev_replace_me

# Speech-to-text (Whisper, hosted by Groq — no credit card or payment needed on Groq's free
# tier). Create a free account at https://console.groq.com, then API Keys, and create a key.
GROQ_API_KEY=gsk_replace_me

# AI analysis (Google Gemini). Create a free key at https://aistudio.google.com/apikey.
GOOGLE_GENERATIVE_AI_API_KEY=
