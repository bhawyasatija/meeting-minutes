{
  "name": "meeting-minutes",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered meeting minutes and action item generator",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:format": "prisma format",
    "trigger:dev": "trigger dev"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.0.0",
    "@fontsource-variable/hanken-grotesk": "^5.0.0",
    "@fontsource-variable/source-serif-4": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@google/genai": "^2.24.0",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@trigger.dev/sdk": "^4.6.4",
    "@uploadthing/react": "^7.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "latest",
    "mammoth": "^1.8.0",
    "music-metadata": "^10.5.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "openai": "^7.23.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "svix": "^1.40.0",
    "tailwind-merge": "^3.0.0",
    "uploadthing": "^7.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@trigger.dev/build": "4.6.4",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^7.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.1.0",
    "trigger.dev": "^4.6.4",
    "typescript": "^5.6.0"
  }
}
